{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["icn1"],
  "installCommand": "cd server && npm install --omit=dev",
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/socket.io/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/src/**",
      "maxDuration": 300
    }
  }
}
