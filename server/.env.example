# 서버
PORT=3000
# 운영(Apache 뒤)에서는 127.0.0.1로 두면 3000번이 VM 밖에서 보이지 않는다. 비우면 모든 주소에서 받음
HOST=
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# 로컬 개발: Express가 ../public 정적 파일도 함께 서비스 (운영에서는 Apache가 담당하므로 false)
SERVE_STATIC=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aquabit
DB_PASSWORD=aquabit-dev-pw
DB_NAME=aquabit

# 시간 배속 (테스트용). 1 = 실제 시간, 3600 = 1초가 1시간
# 물고기 배고픔(24h)/시무룩(72h) 판정에 적용된다.
TIME_SCALE=1

# 관리자 (처음 요구사항에서는 제외 항목이라 끌 수 있게 둠)
# ADMIN_ENABLED=false 이면 /api/admin 과 관리자 화면이 막히고 seed도 관리자 계정을 만들지 않는다.
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
# 비워 두면 관리자 계정을 만들지 않는다. 운영 서버에서는 반드시 긴 비밀번호로.
ADMIN_PASSWORD=
