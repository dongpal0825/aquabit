# 서버
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# 로컬 개발: Express가 ../public 정적 파일도 함께 서비스 (운영에서는 Apache가 담당하므로 false)
SERVE_STATIC=true

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aquabit
DB_PASSWORD=aquabit-dev-pw
DB_NAME=aquabit

# 시간 배속 (테스트용). 1 = 실제 시간, 3600 = 1초가 1시간
# 물고기 배고픔(24h)/시무룩(72h) 판정에 적용된다.
TIME_SCALE=1
